{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "build/Debug/Alternative_ADI_USBI.elf",
            "name": "pyocd",
            "request": "launch",
            "type": "cortex-debug",
            "targetId":  "PY32F071xB",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "pyocd",
            "overrideGDBServerStartedRegex":"GDB server listening on port",
            "cmsisPack": "${env:PYSDEPATH}/packs/PY32F0xx_DFP.pack",
            "svdFile": "${env:PYSDEPATH}/svd/PY32F071xx.svd"
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "openocd",
            "servertype": "openocd",
            "executable": "build/Debug/Alternative_ADI_USBI.elf",
            "runToEntryPoint": "main",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/py32f071.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi",
            "svdFile": "${env:PYSDEPATH}/svd/PY32F071xx.svd"
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "jlink",
            "servertype": "jlink",
            "interface": "swd",
            "executable": "build/Debug/Alternative_ADI_USBI.elf",
            "runToEntryPoint": "main",
            "device": "PY32F071xB",
            "toolchainPrefix": "arm-none-eabi",
            "svdFile": "${env:PYSDEPATH}/svd/PY32F071xx.svd"
        }
    ]
}